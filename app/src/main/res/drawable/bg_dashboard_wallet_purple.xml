<?xml version="1.0" encoding="utf-8"?>
<!-- Wallet row: violet gradient with gloss + edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/dashboard_wallet_purple_start"
                android:endColor="@color/dashboard_wallet_purple_end" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/card_gloss_start"
                android:centerColor="@color/card_gloss_mid"
                android:endColor="@color/card_gloss_end" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/card_edge" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
