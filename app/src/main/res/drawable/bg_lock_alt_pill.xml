<?xml version="1.0" encoding="utf-8"?>
<!-- Alt-action pill: transparent with cool hairline; pressed state
     fills royal so the fingerprint/PIN toggle feels tactile. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pin_key_pressed_top" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/pin_key_stroke" />
            <padding
                android:left="20dp"
                android:top="10dp"
                android:right="20dp"
                android:bottom="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/pin_key_stroke" />
            <padding
                android:left="20dp"
                android:top="10dp"
                android:right="20dp"
                android:bottom="10dp" />
        </shape>
    </item>
</selector>
