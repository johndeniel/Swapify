<?xml version="1.0" encoding="utf-8"?>
<!-- Passport face: maroon gradient document. No outline, no artwork. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="@color/passport_bg_start"
        android:endColor="@color/passport_bg_end"
        android:type="linear" />
    <corners android:radius="16dp" />
</shape>
