<?xml version="1.0" encoding="utf-8"?>
<!-- Lock-screen logo tile: deep-blue gradient rounded square, the app-mark
     well behind the shield. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="45"
        android:startColor="@color/card_blue_center"
        android:endColor="@color/card_blue_start" />
    <corners android:radius="26dp" />
    <stroke android:width="1dp" android:color="@color/card_edge" />
</shape>
