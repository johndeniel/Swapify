<?xml version="1.0" encoding="utf-8"?>
<!-- Photo well for the fixed ID-face placeholder: light "photo paper" on all
     six faces (real documents keep a light photo area even on dark cards). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFE9EEF3" />
    <stroke
        android:width="1dp"
        android:color="#FFB7C2CE" />
    <corners android:radius="8dp" />
</shape>
