<?xml version="1.0" encoding="utf-8"?>
<!-- Central reusable ID face: neutral charcoal-gold document style that suits -->
<!-- ANY government ID (National ID, Driver's License, Passport, SSS, GSIS…). -->
<!-- Per-type identity comes from bound text (title, number label), not layout. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FF141920"
                android:centerColor="#FF1F2733"
                android:endColor="#FF2E3A4D" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#FF0B0E13" />
        </shape>
    </item>

    <!-- Wide diagonal sheen, top-right. -->
    <item>
        <rotate
            android:fromDegrees="-20"
            android:pivotX="85%"
            android:pivotY="0%">
            <shape android:shape="rectangle">
                <solid android:color="#14FFFFFF" />
                <size
                    android:width="110dp"
                    android:height="400dp" />
            </shape>
        </rotate>
    </item>

    <!-- Thin gold diagonal accent next to the sheen. -->
    <item>
        <rotate
            android:fromDegrees="-20"
            android:pivotX="68%"
            android:pivotY="0%">
            <shape android:shape="rectangle">
                <solid android:color="#2EC9A227" />
                <size
                    android:width="10dp"
                    android:height="400dp" />
            </shape>
        </rotate>
    </item>

    <!-- Gold foot bar, rounded bottom corners only. -->
    <item android:top="193dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFC9A227" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="16dp"
                android:bottomRightRadius="16dp" />
        </shape>
    </item>

</layer-list>
