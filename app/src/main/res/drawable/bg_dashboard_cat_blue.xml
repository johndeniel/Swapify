<?xml version="1.0" encoding="utf-8"?>
<!-- Category card: deep blue-tinted gradient with cool hairline edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/dashboard_cat_blue_start"
                android:endColor="@color/dashboard_cat_blue_end" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/dashboard_cat_blue_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
