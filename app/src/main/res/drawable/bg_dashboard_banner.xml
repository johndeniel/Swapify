<?xml version="1.0" encoding="utf-8"?>
<!-- Privacy banner: clean 3-stop blue ramp sampled from the reference
     (bright left -> royal mid -> dark navy right), thin cool-blue edge.
     No white gloss overlay so the base colors stay accurate. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/dashboard_banner_start"
                android:centerColor="@color/dashboard_banner_center"
                android:endColor="@color/dashboard_banner_end" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/dashboard_banner_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
