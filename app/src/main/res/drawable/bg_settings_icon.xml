<?xml version="1.0" encoding="utf-8"?>
<!-- Settings icon well: lifted navy tile with cool hairline, dark stage for
     light row icons (matches the dashboard card surface). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/dashboard_surface" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="@color/dashboard_surface_border" />
</shape>
