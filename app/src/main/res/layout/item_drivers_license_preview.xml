<?xml version="1.0" encoding="utf-8"?>
<!-- Driver's License face — clean LTO-front homage: flat pearl document, -->
<!-- dark-ink structured rows. No photo, no logo, no artwork. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_marginHorizontal="4dp"
    android:elevation="2dp"
    android:background="@drawable/bg_drivers_license">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preview_republic"
            android:textColor="@color/dl_muted"
            android:textSize="8sp"
            android:textStyle="bold"
            android:letterSpacing="0.24"
            android:singleLine="true" />

        <TextView
            android:id="@+id/preview_id_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/preview_government_id"
            android:textColor="@color/dl_ink"
            android:textSize="19sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:singleLine="true" />

        <TextView
            android:id="@+id/preview_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/preview_government_id"
            android:textColor="@color/dl_accent"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.22"
            android:singleLine="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/dl_bar" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/preview_number_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preview_number_label"
            android:textColor="@color/dl_muted"
            android:textSize="8sp"
            android:textStyle="bold"
            android:letterSpacing="0.24"
            android:singleLine="true" />

        <TextView
            android:id="@+id/preview_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/empty_value"
            android:textColor="@color/dl_ink"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.03"
            android:maxLines="1"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/preview_holder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/preview_person_name"
                android:textColor="@color/dl_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:singleLine="true" />

            <TextView
                android:id="@+id/preview_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/dl_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:maxLines="1"
                android:singleLine="true" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
