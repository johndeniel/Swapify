<?xml version="1.0" encoding="utf-8"?>
<!-- National ID face — clean PhilID-front homage: flat white document, navy -->
<!-- ink, structured label/value rows. No photo, no seal, no artwork. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_marginHorizontal="4dp"
    android:elevation="2dp"
    android:background="@drawable/bg_national_id">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preview_republic"
            android:textColor="@color/national_muted"
            android:textSize="8sp"
            android:textStyle="bold"
            android:letterSpacing="0.24"
            android:singleLine="true" />

        <TextView
            android:id="@+id/preview_id_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/preview_government_id"
            android:textColor="@color/national_ink"
            android:textSize="19sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:singleLine="true" />

        <TextView
            android:id="@+id/preview_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/preview_government_id"
            android:textColor="@color/national_muted"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.22"
            android:singleLine="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/national_rule" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preview_person_label"
            android:textColor="@color/national_muted"
            android:textSize="8sp"
            android:textStyle="bold"
            android:letterSpacing="0.24"
            android:singleLine="true" />

        <TextView
            android:id="@+id/preview_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/preview_person_name"
            android:textColor="@color/national_ink"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="bottom">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/preview_number_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/preview_number_label"
                    android:textColor="@color/national_muted"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.24"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/preview_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/empty_value"
                    android:textColor="@color/national_ink"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.03"
                    android:maxLines="1"
                    android:singleLine="true" />

            </LinearLayout>

            <TextView
                android:id="@+id/preview_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/national_muted"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:maxLines="2" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
