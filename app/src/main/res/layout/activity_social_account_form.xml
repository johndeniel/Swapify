<?xml version="1.0" encoding="utf-8"?>
<!-- Social account form: dashboard-navy theme (bg_dashboard_root,
     bg_dashboard_card rows, dashboard_muted labels) shared with the bank and
     government ID forms. Back chevron on top, no title block — the platform
     row names the account. Twin outline action row (save + edit-only delete)
     copied from the bank card form; keep the rows in sync. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_root"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <!-- Back navigation, same as the bank and government ID forms. -->
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="-12dp"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="@string/cd_back"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/field_platform"
        android:textColor="@color/dashboard_muted"
        android:textSize="13sp"
        android:layout_marginTop="12dp" />

    <LinearLayout
        android:id="@+id/platform_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_dashboard_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/platform_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_dashboard_icon_white"
            android:scaleType="fitCenter"
            android:padding="7dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/platform_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_dropdown"
            android:contentDescription="@string/cd_select_platform" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/section_account_details"
        android:textColor="@color/dashboard_muted"
        android:textSize="13sp"
        android:layout_marginTop="24dp" />

    <!-- Username row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dashboard_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_person"
            android:alpha="0.6"
            android:contentDescription="@null"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/field_username"
                android:textColor="@color/dashboard_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/input_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/hint_username"
                android:textColorHint="@color/hint_text"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="textEmailAddress"
                android:paddingTop="2dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Password row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dashboard_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_lock"
            android:alpha="0.6"
            android:contentDescription="@null"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/field_password"
                android:textColor="@color/dashboard_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/input_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/mask_password"
                android:textColorHint="@color/hint_text"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="textPassword"
                android:paddingTop="2dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btn_toggle_password"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_eye"
            android:alpha="0.6"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/cd_toggle_visibility" />

    </LinearLayout>

    <!-- PIN row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dashboard_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_lock"
            android:alpha="0.6"
            android:contentDescription="@null"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/field_pin"
                android:textColor="@color/dashboard_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/input_pin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/mask_pin"
                android:textColorHint="@color/hint_text"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:paddingTop="2dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/btn_toggle_pin"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_eye"
            android:alpha="0.6"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/cd_toggle_visibility" />

    </LinearLayout>

    <!-- Mobile number row (below PIN) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dashboard_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_phone"
            android:alpha="0.6"
            android:contentDescription="@null"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/field_mobile"
                android:textColor="@color/dashboard_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/input_mobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/hint_mobile"
                android:textColorHint="@color/hint_text"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:singleLine="true"
                android:inputType="phone"
                android:maxLength="15"
                android:paddingTop="2dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Associated accounts: dashboard-style section header (bold title left,
         outline Add pill right) over a dashboard card holding the rows. -->
    <LinearLayout
        android:id="@+id/associate_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_associated_accounts"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/btn_add_associate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_add"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_add_circle"
                    android:contentDescription="@string/cd_add_account" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dashboard_card"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_linked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false" />

            <!-- Empty state: muted line inside the card so the section (and
                 its Add action) stays on screen with nothing linked. -->
            <TextView
                android:id="@+id/empty_linked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="16dp"
                android:text="No associated accounts"
                android:textColor="@color/dashboard_muted"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- Save/Delete action row, same twin-outline pattern as the bank and
         government ID forms. Delete shows in edit mode only. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/action_save"
                android:src="@drawable/ic_edit" />

            <TextView
                android:id="@+id/text_save_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/action_save"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_delete"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_outline_red"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/action_delete"
                android:src="@drawable/ic_delete" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/action_delete"
                android:textColor="@color/danger"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

</androidx.core.widget.NestedScrollView>
