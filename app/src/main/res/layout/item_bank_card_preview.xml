<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_marginHorizontal="4dp"
    android:background="@drawable/bg_bank_card_blue">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/preview_bank"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="YOUR BANK"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold|italic" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/preview_network"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VISA"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold|italic" />

                <TextView
                    android:id="@+id/preview_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEBIT"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:layout_width="34dp"
            android:layout_height="26dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/chip"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="Card chip" />

        <TextView
            android:id="@+id/preview_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="•••• •••• •••• ••••"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/preview_holder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CARDHOLDER NAME"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/preview_expiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MM/YY"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
