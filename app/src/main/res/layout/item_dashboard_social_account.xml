<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard Social Account row: one created social login.
     Icon well + platform/username + chevron; tap opens Logins.
     Hairline divider below every row except the last (toggled by adapter). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/social_icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_dashboard_icon_white"
            android:contentDescription="Platform"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/google" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

        <TextView
            android:id="@+id/social_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Platform"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

            <TextView
                android:id="@+id/social_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="username"
                android:textColor="@color/dashboard_muted"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/social_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@color/dashboard_surface_border" />

</LinearLayout>
