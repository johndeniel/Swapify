<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     Akin Wallet — Dashboard (Home).
      New overhaul layout matching the MyKey reference:
       professional header, Social Account,
      Your Wallet gradient rows, circular quick-add FAB. Loaded by DashboardFragment,
     hosted in MainActivity's fragment_container.
     activity_main.xml is untouched in structure (kept).
     ============================================================ -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_root">

        <!-- Fixed dashboard content (not scrollable); FAB floats over it, no reserved gap -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

        <!-- Akin Wallet header: app wordmark + trust tagline.
             Transparent so the dashboard navy theme shows through (no banner card). -->
        <LinearLayout
            android:id="@+id/header_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:text="@string/header_tagline"
                    android:textColor="@color/dashboard_muted"
                    android:textSize="12sp" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/btn_header_notification"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_dashboard_circle"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_notifications"
                    android:src="@drawable/ic_bell" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="9dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/danger_bright" />

            </FrameLayout>

        </LinearLayout>

        <!-- Government ID section header (no tab: View All removed) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Government ID"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Government ID carousel (live: renders IDs created in Government ID) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_ids_carousel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingEnd="36dp" />

        <!-- Empty state: shown when no government ID exists yet -->
        <LinearLayout
            android:id="@+id/empty_ids"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_dashboard_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No goverment"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="An ID you add will appear here"
                android:textColor="@color/dashboard_muted"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Bank Card section header (no tab: View All removed) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bank Card"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Bank card carousel (live: renders cards created in Bank Card) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_cards_carousel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingEnd="36dp" />

        <!-- Empty state: shown when no bank card exists yet -->
        <LinearLayout
            android:id="@+id/empty_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_dashboard_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No bank card"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="A card you add will appear here"
                android:textColor="@color/dashboard_muted"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Social Account section header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Social Account"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_view_all_social"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="View All"
                android:textColor="@color/dashboard_muted"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Social Account card (live: created social accounts only) -->
        <LinearLayout
            android:id="@+id/card_social_accounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dashboard_card"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_social_accounts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

        <!-- Empty state: shown when no social account exists yet. Weight 1
             stretches it to occupy the rest of the screen. -->
        <LinearLayout
            android:id="@+id/empty_social_accounts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dashboard_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No social account yet"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="An account you add will appear here"
                android:textColor="@color/dashboard_muted"
                android:textSize="12sp" />

        </LinearLayout>

        </LinearLayout>

    <!-- Scrim: dims content while the quick-add menu is open; tap closes the menu -->
    <View
        android:id="@+id/fab_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/text_shadow"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!-- M3 FAB menu: tonal pills (theme container, light label, blue icon),
         equal widths, trailing-edge aligned, 4dp FAB-to-menu gap. -->
    <LinearLayout
        android:id="@+id/fab_add_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="76dp"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_option_id"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="8dp"
            android:text="@string/dialog_id_title"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/dashboard_surface"
            app:strokeColor="@color/dashboard_surface_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_option_card"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="8dp"
            android:text="@string/dialog_bank_title"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/dashboard_surface"
            app:strokeColor="@color/dashboard_surface_border"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_option_login"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/dialog_social_title"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/dashboard_surface"
            app:strokeColor="@color/dashboard_surface_border"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <!-- FAB menu close button: true circle via shape overlay (cornerSize is
         ignored by FAB), no compat padding so the 56dp visual sits exactly
         on the 16dp margins and clears the menu above it. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/fab_add"
        android:src="@drawable/ic_add"
        app:backgroundTint="?attr/colorPrimary"
        app:elevation="8dp"
        app:fabSize="normal"
        app:pressedTranslationZ="12dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Circle"
        app:tint="@color/white" />

</FrameLayout>
