<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard card carousel page. Reuses the same professional card face
     as the Cards tab (true 1.586:1 ratio) so added cards look identical
     here and in Bank Card. Width is match_parent; the host RecyclerView
     uses end-padding + clipToPadding=false so the next card peeks. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <include layout="@layout/item_bank_card_preview" />

</FrameLayout>
