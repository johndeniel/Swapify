<?xml version="1.0" encoding="utf-8"?>
<!-- CENTRAL reusable government-ID face. One layout serves every ID type: -->
<!-- National ID, Driver's License, Passport, SSS, PhilHealth and future. -->
<!-- Per-type identity (background, ink, titles, numbers, photo-well tint) -->
<!-- is bound in code from IdTypeSpec; only structure lives here. -->
<!-- Title header on top, rule, then a small square photo well below the -->
<!-- line with the data column beside it. The eyebrow line is retired -->
<!-- (gone) — the subtitle carries the agency. The photo is static decor: -->
<!-- it never changes, only its tint adapts to the card. Ratio 1.586:1. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/card_root"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="4dp"
        android:elevation="2dp"
        android:background="@drawable/bg_national_id"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,1.586:1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <!-- Retired eyebrow: kept (gone) so existing adapter bindings
                 still resolve; subtitle carries the agency. -->
            <TextView
                android:id="@+id/preview_eyebrow"
                style="@style/IdFaceEyebrow"
                android:text="@string/preview_republic"
                android:textColor="@color/national_muted"
                android:visibility="gone"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/preview_id_type"
                style="@style/IdFaceTitle"
                android:text="@string/preview_government_id"
                android:textColor="@color/national_ink"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/preview_subtitle"
                style="@style/IdFaceSubtitle"
                android:text="@string/preview_government_id"
                android:textColor="@color/national_muted"
                android:maxLines="1"
                android:ellipsize="end" />

            <View
                android:id="@+id/preview_rule"
                style="@style/IdFaceRule"
                android:background="@color/national_rule" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Square photo well below the line. Data stacks under it:
                 full name first, then number + value + meta. -->
            <FrameLayout
                android:id="@+id/preview_photo_box"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_id_photo_placeholder">

                <ImageView
                    android:id="@+id/preview_photo_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    android:contentDescription="@string/cd_id_photo" />

            </FrameLayout>

            <!-- Full name full-width below the square. -->
            <TextView
                android:id="@+id/preview_holder_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/preview_person_label"
                android:textColor="@color/national_muted"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.26"
                android:maxLines="1"
                android:singleLine="true" />

            <TextView
                android:id="@+id/preview_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/preview_person_name"
                android:textColor="@color/national_ink"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Number + value + meta below the full name. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="bottom">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/preview_number_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/preview_number_label"
                        android:textColor="@color/national_muted"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.26"
                        android:maxLines="1"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/preview_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/empty_value"
                        android:textColor="@color/national_ink"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.04"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end" />

                </LinearLayout>

                <TextView
                    android:id="@+id/preview_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_gravity="bottom"
                    android:gravity="end"
                    android:maxWidth="130dp"
                    android:textColor="@color/national_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end" />

            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
