<?xml version="1.0" encoding="utf-8"?>
<!-- CENTRAL reusable government-ID face. One layout serves every ID type: -->
<!-- National ID, Driver's License, Passport, SSS, PhilHealth and future. -->
<!-- Per-type identity (background, ink, titles, numbers) is bound in code -->
<!-- from IdTypeSpec; only structural styling lives here via IdFace styles. -->
<!-- Outer ConstraintLayout keeps a true card ratio (1.586:1) on every -->
<!-- screen: height is derived from width, so the face is never flat/lengthy -->
<!-- in the list nor cramped in the horizontal picker. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/card_root"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="4dp"
        android:elevation="2dp"
        android:background="@drawable/bg_national_id"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,1.586:1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                style="@style/IdFaceEyebrow"
                android:text="@string/preview_republic"
                android:textColor="@color/national_muted"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/preview_id_type"
                style="@style/IdFaceTitle"
                android:text="@string/preview_government_id"
                android:textColor="@color/national_ink"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/preview_subtitle"
                style="@style/IdFaceSubtitle"
                android:text="@string/preview_government_id"
                android:textColor="@color/national_muted"
                android:maxLines="1"
                android:ellipsize="end" />

            <View
                android:id="@+id/preview_rule"
                style="@style/IdFaceRule"
                android:background="@color/national_rule" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/preview_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preview_person_name"
                android:textColor="@color/national_ink"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="bottom">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/preview_number_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/preview_number_label"
                        android:textColor="@color/national_muted"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.26"
                        android:maxLines="1"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/preview_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/empty_value"
                        android:textColor="@color/national_ink"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.04"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end" />

                </LinearLayout>

                <TextView
                    android:id="@+id/preview_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/national_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:ellipsize="end" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
