<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.AkinWallet" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:colorAccent">@color/brand_blue</item>
        <item name="colorSurface">@color/dashboard_bg_start</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:windowBackground">@color/dashboard_bg_start</item>
        <item name="android:statusBarColor">@color/dashboard_bg_start</item>
        <item name="android:navigationBarColor">@color/dashboard_bg_start</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.AkinWallet" parent="Base.Theme.AkinWallet" />

    <style name="NoIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/brand_blue</item>
    </style>

    <!-- Shared government-ID face header. Sizes, tracking and rhythm live
         here so all 6 faces stay identical; each face sets only its text,
         ink colors and rule color. Title is the single bold anchor;
         eyebrow/subtitle stay quiet for a clean document hierarchy. -->
    <style name="IdFaceEyebrow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">8sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.28</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="IdFaceTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="IdFaceSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">8sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="IdFaceRule">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
</resources>
