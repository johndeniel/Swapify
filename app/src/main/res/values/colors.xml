<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================
         Akin Wallet — color system (dark theme).
         Names are semantic (role), never raw values, so a rebrand
         means editing this file only. Opacity variants carry their
         role, e.g. text on light card faces vs. gloss overlays.
         ============================================================ -->

    <!-- Brand -->
    <color name="brand_blue">#FF2196F3</color>

    <!-- App surfaces -->
    <color name="dark_bg">#FF0D1B2A</color>
    <color name="dark_card">#FF1B2838</color>
    <color name="dark_card_border">#FF2A3A4A</color>

    <!-- Core text & graphics -->
    <color name="text_primary">#FFFFFFFF</color>
    <color name="text_secondary">#FF8899AA</color>
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>

    <!-- Feedback -->
    <color name="danger">#FFEE4444</color>
    <color name="danger_bright">#FFFF5252</color>

    <!-- Input hints -->
    <color name="hint_text">#55FFFFFF</color>

    <!-- Text on light card faces (white with alpha steps) -->
    <color name="text_muted_light">#99FFFFFF</color>
    <color name="text_faint_light">#8CFFFFFF</color>
    <color name="text_subtle_light">#B3FFFFFF</color>
    <color name="text_bright_light">#E6FFFFFF</color>
    <color name="text_pale_blue">#FFE8EDF5</color>
    <color name="text_shadow">#80000000</color>

    <!-- Gloss & edge overlays drawn over card gradients -->
    <color name="card_gloss_start">#30FFFFFF</color>
    <color name="card_gloss_mid">#08FFFFFF</color>
    <color name="card_gloss_end">#00FFFFFF</color>
    <color name="card_edge">#33FFFFFF</color>

    <!-- Bank card gradients (one ramp per card colorway) -->
    <color name="card_blue_start">#FF0A1F44</color>
    <color name="card_blue_center">#FF1E4B9E</color>
    <color name="card_blue_end">#FF060F26</color>
    <color name="card_purple_start">#FF2A0A44</color>
    <color name="card_purple_center">#FF5E2A9E</color>
    <color name="card_purple_end">#FF150626</color>
    <color name="card_green_start">#FF04302A</color>
    <color name="card_green_center">#FF0E6B5E</color>
    <color name="card_green_end">#FF031713</color>
    <color name="card_orange_start">#FF431207</color>
    <color name="card_orange_center">#FF9E4E1E</color>
    <color name="card_orange_end">#FF200A04</color>
    <color name="card_slate_start">#FF111B28</color>
    <color name="card_slate_center">#FF33465E</color>
    <color name="card_slate_end">#FF05080E</color>

    <!-- National ID face (flat white document, navy ink) -->
    <color name="national_ink">#FF14315F</color>
    <color name="national_muted">#FF5A6B8C</color>
    <color name="national_rule">#FF1E4480</color>

    <!-- Driver's License face (flat pearl document, purple-blue ink) -->
    <color name="dl_card_bg">#FFF6F3FD</color>
    <color name="card_hairline">#FFD9E1EA</color>
    <color name="dl_bar">#FF6A5AA8</color>
    <color name="dl_ink">#FF2B2545</color>
    <color name="dl_muted">#FF8B84A8</color>
    <color name="dl_accent">#FF4A3F7A</color>
</resources>
